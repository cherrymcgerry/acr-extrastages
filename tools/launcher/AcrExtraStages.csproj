<Project Sdk="Microsoft.NET.Sdk">
  <!-- ACR Extra Stages launcher (single-file, self-contained): detect, preflight, mappings, prepare, build, verify, install.
       Publish: see tools/launcher/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AcrExtraStages</AssemblyName>
    <RootNamespace>AcrExtraStages</RootNamespace>
    <!-- Version comes from the VERSION file via tools/Directory.Build.props. -->
    <Product>ACR Extra Stages</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>
